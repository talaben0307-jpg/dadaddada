local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local VirtualUser = game:GetService("VirtualUser")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local env = (getgenv and getgenv()) or _G

if env.NinjaFarm_Cleanup then
	pcall(env.NinjaFarm_Cleanup)
end

-- Tùy chỉnh khoảng cách gom quái
local RADIUS = 80 

local State = {
    KillAura = false,
    FastM1 = false
}
local connections = {}

-- ==================== TẠO GIAO DIỆN (UI) ====================
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "NinjaFarmGui"
ScreenGui.ResetOnSpawn = false
local success, guiParent = pcall(function() return gethui() end)
ScreenGui.Parent = success and guiParent or CoreGui

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.fromOffset(250, 160)
MainFrame.Position = UDim2.fromScale(0.5, 0.5)
MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
MainFrame.BorderSizePixel = 0
MainFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 10)
UICorner.Parent = MainFrame

local UIStroke = Instance.new("UIStroke")
UIStroke.Color = Color3.fromRGB(255, 0, 80)
UIStroke.Thickness = 2
UIStroke.Parent = MainFrame

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 30)
Title.BackgroundTransparency = 1
Title.Font = Enum.Font.GothamBold
Title.Text = "🗡️ AUTO NINJA FARM"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize = 14
Title.Parent = MainFrame

local CloseBtn = Instance.new("TextButton")
CloseBtn.Size = UDim2.fromOffset(24, 24)
CloseBtn.Position = UDim2.new(1, -30, 0, 3)
CloseBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
CloseBtn.Text = "X"
CloseBtn.Font = Enum.Font.GothamBold
CloseBtn.TextColor3 = Color3.fromRGB(255,255,255)
CloseBtn.Parent = MainFrame
Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 5)

-- Kéo thả UI
local dragging, dragInput, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = MainFrame.Position
	end
end)
MainFrame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

-- Hàm tạo nút Toggle
local function createToggle(yPos, text, varName)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, -20, 0, 40)
    Btn.Position = UDim2.new(0, 10, 0, yPos)
    Btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    Btn.Font = Enum.Font.GothamBold
    Btn.Text = text .. " : OFF"
    Btn.TextColor3 = Color3.fromRGB(150, 150, 150)
    Btn.TextSize = 13
    Btn.Parent = MainFrame
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)

    Btn.MouseButton1Click:Connect(function()
        State[varName] = not State[varName]
        if State[varName] then
            Btn.BackgroundColor3 = Color3.fromRGB(0, 200, 80)
            Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            Btn.Text = text .. " : ON"
        else
            Btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
            Btn.TextColor3 = Color3.fromRGB(150, 150, 150)
            Btn.Text = text .. " : OFF"
        end
    end)
end

createToggle(45, "🌪️ Gom Quái (Kill Aura)", "KillAura")
createToggle(95, "⚔️ Spam M1 (No Cooldown)", "FastM1")

-- ==================== LOGIC HACK ====================

-- 1. Kill Aura (Gom toàn bộ quái trong phạm vi lại sát mặt bạn)
table.insert(connections, RunService.Heartbeat:Connect(function()
    if not State.KillAura then return end
    
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        -- Xác định quái (Có Humanoid, không phải người chơi)
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
            if not Players:GetPlayerFromCharacter(obj) and obj.Humanoid.Health > 0 then
                
                local mobHrp = obj.HumanoidRootPart
                local dist = (myHrp.Position - mobHrp.Position).Magnitude
                
                -- Nếu quái trong phạm vi, dịch chuyển nó đến trước mặt mình
                if dist <= RADIUS then
                    -- Gom quái cách mặt 3 studs để chém trúng
                    mobHrp.CFrame = myHrp.CFrame * CFrame.new(0, 0, -3)
                    mobHrp.Velocity = Vector3.new(0,0,0)
                    
                    -- Phá vỡ khả năng tấn công của quái (tùy game)
                    if obj.Humanoid:FindFirstChild("Animator") then
                        obj.Humanoid.Animator:Destroy()
                    end
                end
            end
        end
    end
end))

-- 2. Fast M1 / Auto Attack (Bypass Cooldown bằng cách click ảo tốc độ cao)
task.spawn(function()
    while true do
        if State.FastM1 then
            -- Giả lập click chuột liên tục không có độ trễ
            VirtualUser:CaptureController()
            VirtualUser:ClickButton1(Vector2.new())
            
            -- Một số game dùng Event cụ thể cho M1, đoạn này rào trước nếu game dùng thư viện mạng chung
            pcall(function()
                local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
                if tool then tool:Activate() end
            end)
        end
        task.wait(0.01) -- Chém siêu nhanh (100 lần / giây)
    end
end)

-- Nút đóng GUI
CloseBtn.MouseButton1Click:Connect(function()
    if env.NinjaFarm_Cleanup then env.NinjaFarm_Cleanup() end
end)

env.NinjaFarm_Cleanup = function()
    State.KillAura = false
    State.FastM1 = false
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    if ScreenGui then ScreenGui:Destroy() end
    env.NinjaFarm_Cleanup = nil
end

pcall(function()
	game:GetService("StarterGui"):SetCore("SendNotification", {
		Title = "Auto Ninja Farm",
		Text = "Tải thành công! Bật 2 nút lên để cày Max Level.",
		Duration = 5,
	})
end)
