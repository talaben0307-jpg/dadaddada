local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local env = (getgenv and getgenv()) or _G

if env.NinjaFarm_Cleanup then
	pcall(env.NinjaFarm_Cleanup)
end

local RADIUS = 80 
local State = { KillAura = false, FastM1 = false }
local connections = {}

local function track(conn)
	table.insert(connections, conn)
	return conn
end

-- ==================== KHỞI TẠO GIAO DIỆN (ĐÃ FIX LỖI) ====================
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "NinjaFarmGui_V2"
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true
ScreenGui.DisplayOrder = 9999

-- Ép hiển thị vào PlayerGui để chống tàng hình
local success = pcall(function() ScreenGui.Parent = (gethui and gethui()) or CoreGui end)
if not success or not ScreenGui.Parent then
	ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
end

-- Code kéo thả cực mượt (Lấy từ bản CyberDodge)
local function makeDraggable(dragHandle, targetFrame)
	local dragging, dragInput, dragStart, startPos
	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = targetFrame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	dragHandle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	track(UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			targetFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end))
end

-- Khung nền chính
local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.fromOffset(260, 140)
MainFrame.Position = UDim2.fromScale(0.5, 0.5)
MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
MainFrame.BorderSizePixel = 0
MainFrame.Parent = ScreenGui
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 10)

local UIStroke = Instance.new("UIStroke", MainFrame)
UIStroke.Color = Color3.fromRGB(255, 0, 80)
UIStroke.Thickness = 2

-- Thanh tiêu đề (Nắm vào đây để kéo)
local Header = Instance.new("Frame")
Header.Size = UDim2.new(1, 0, 0, 40)
Header.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
Header.BorderSizePixel = 0
Header.Parent = MainFrame
Instance.new("UICorner", Header).CornerRadius = UDim.new(0, 10)

local HeaderFix = Instance.new("Frame")
HeaderFix.Size = UDim2.new(1, 0, 0, 10)
HeaderFix.Position = UDim2.new(0, 0, 1, -10)
HeaderFix.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
HeaderFix.BorderSizePixel = 0
HeaderFix.Parent = Header

makeDraggable(Header, MainFrame) -- Kích hoạt kéo thả

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, -40, 1, 0)
Title.Position = UDim2.fromOffset(15, 0)
Title.BackgroundTransparency = 1
Title.Font = Enum.Font.GothamBold
Title.Text = "🗡️ AUTO NINJA FARM"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize = 14
Title.TextXAlignment = Enum.TextXAlignment.Left
Title.Parent = Header

local CloseBtn = Instance.new("TextButton")
CloseBtn.Size = UDim2.fromOffset(26, 26)
CloseBtn.Position = UDim2.new(1, -32, 0.5, -13)
CloseBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
CloseBtn.Text = "X"
CloseBtn.Font = Enum.Font.GothamBold
CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
CloseBtn.Parent = Header
Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 6)

-- Vùng chứa nút bấm
local Container = Instance.new("Frame")
Container.Size = UDim2.new(1, -20, 1, -50)
Container.Position = UDim2.fromOffset(10, 46)
Container.BackgroundTransparency = 1
Container.Parent = MainFrame

local UIListLayout = Instance.new("UIListLayout")
UIListLayout.Padding = UDim.new(0, 6)
UIListLayout.Parent = Container

local function createToggle(text, varName)
	local Btn = Instance.new("TextButton")
	Btn.Size = UDim2.new(1, 0, 0, 38)
	Btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
	Btn.Font = Enum.Font.GothamBold
	Btn.Text = text .. " : OFF"
	Btn.TextColor3 = Color3.fromRGB(150, 150, 150)
	Btn.TextSize = 13
	Btn.Parent = Container
	Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)

	Btn.MouseButton1Click:Connect(function()
		State[varName] = not State[varName]
		if State[varName] then
			Btn.BackgroundColor3 = Color3.fromRGB(0, 200, 80)
			Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			Btn.Text = text .. " : ON"
		else
			Btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
			Btn.TextColor3 = Color3.fromRGB(150, 150, 150)
			Btn.Text = text .. " : OFF"
		end
	end)
end

-- Tạo 2 nút chức năng
createToggle("🌪️ Gom Quái (Kill Aura)", "KillAura")
createToggle("⚔️ Spam M1 (No Cooldown)", "FastM1")


-- ==================== LOGIC HACK (ĐÃ BỌC CHỐNG CRASH) ====================

-- 1. Gom quái (Kill Aura)
track(RunService.Heartbeat:Connect(function()
	if not State.KillAura then return end
	
	local myChar = LocalPlayer.Character
	local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myHrp then return end

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
			if not Players:GetPlayerFromCharacter(obj) and obj.Humanoid.Health > 0 then
				local mobHrp = obj.HumanoidRootPart
				local dist = (myHrp.Position - mobHrp.Position).Magnitude
				
				if dist <= RADIUS then
					-- Hút quái về cách mặt mình 3 studs
					mobHrp.CFrame = myHrp.CFrame * CFrame.new(0, 0, -3.5)
					mobHrp.Velocity = Vector3.new(0,0,0)
					
					-- Vô hiệu hóa đánh trả của quái
					local animator = obj.Humanoid:FindFirstChild("Animator")
					if animator then
						pcall(function() animator:Destroy() end)
					end
				end
			end
		end
	end
end))

-- 2. Spam Click (No Cooldown)
local runningM1 = true
task.spawn(function()
	while runningM1 do
		if State.FastM1 then
			-- Cách 1: Kích hoạt tool đang cầm trên tay (Dành cho điện thoại)
			pcall(function()
				local char = LocalPlayer.Character
				if char then
					local tool = char:FindFirstChildOfClass("Tool")
					if tool then tool:Activate() end
				end
			end)
			
			-- Cách 2: Bấm ảo chuột trái (Dành cho PC/Một số Executor)
			pcall(function()
				local vu = game:GetService("VirtualUser")
				if vu then
					vu:CaptureController()
					vu:ClickButton1(Vector2.new())
				end
			end)
		end
		task.wait(0.01)
	end
end)

-- Nút đóng UI
CloseBtn.MouseButton1Click:Connect(function()
	if env.NinjaFarm_Cleanup then env.NinjaFarm_Cleanup() end
end)

-- Dọn dẹp an toàn khi tắt
env.NinjaFarm_Cleanup = function()
	State.KillAura = false
	State.FastM1 = false
	runningM1 = false
	for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
	table.clear(connections)
	if ScreenGui then pcall(function() ScreenGui:Destroy() end) end
	env.NinjaFarm_Cleanup = nil
end

pcall(function()
	game:GetService("StarterGui"):SetCore("SendNotification", {
		Title = "Auto Ninja Farm",
		Text = "Tải thành công! Kéo bằng thanh đen phía trên nhé.",
		Duration = 5,
	})
end)
